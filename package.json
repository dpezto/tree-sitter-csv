{
  "name": "tree-sitter-csv",
  "version": "1.2.0",
  "description": "CSV, PSV, & TSV grammar for tree-sitter",
  "main": "bindings/node",
  "keywords": [
    "parsing",
    "incremental",
    "csv",
    "psv",
    "tsv"
  ],
  "author": "Amaan Qureshi <amaanq12@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^8.5.0"
  },
  "devDependencies": {
    "eslint": "^8.47.0",
    "eslint-config-google": "^0.14.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "^0.25.10"
  },
  "scripts": {
    "build": "npm run build-csv && npm run build-psv && npm run build-tsv",
    "build-csv": "cd csv && tree-sitter generate --abi 15",
    "build-psv": "cd psv && tree-sitter generate --abi 15",
    "build-tsv": "cd tsv && tree-sitter generate --abi 15",
    "lint": "eslint common/define-grammar.js csv/grammar.js psv/grammar.js tsv/grammar.js",
    "test-load": "node --test bindings/node/binding_test.js",
    "test": "tree-sitter test && npm run test-load",
    "test-windows": "npm test"
  }
}

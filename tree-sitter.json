{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "csv",
      "scope": "source.csv",
      "path": "csv",
      "file-types": [
        "csv"
      ],
      "injection-regex": "^csv$",
      "highlights": "csv/queries/highlights.scm",
      "external-files": [
        "common/define-grammar.js",
        "common/empty-field-scanner.h"
      ]
    },
    {
      "name": "psv",
      "scope": "source.psv",
      "path": "psv",
      "file-types": [
        "psv"
      ],
      "injection-regex": "^psv$",
      "highlights": "psv/queries/highlights.scm",
      "external-files": [
        "common/define-grammar.js",
        "common/empty-field-scanner.h"
      ]
    },
    {
      "name": "tsv",
      "scope": "source.tsv",
      "path": "tsv",
      "file-types": [
        "tsv"
      ],
      "injection-regex": "^tsv$",
      "highlights": "tsv/queries/highlights.scm",
      "external-files": [
        "common/define-grammar.js",
        "common/empty-field-scanner.h"
      ]
    }
  ],
  "metadata": {
    "version": "1.2.0",
    "license": "MIT",
    "description": "CSV, PSV, & TSV grammars for tree-sitter",
    "authors": [
      {
        "name": "Dai L\u00f3pez",
        "email": "dpezto@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/dpezto/tree-sitter-csv"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
